# User Microservice Environment Configuration
# Copy this to .env.dev or .env for local development
# Never commit .env files with real secrets to git!

# ==================== Environment ====================
APP_ENV=dev

# ==================== Database ====================
# Local PostgreSQL (when running locally)
DB_URL=postgresql+asyncpg://api_user:pass123@localhost:5432/user_microservice_db
# Docker PostgreSQL (uncomment when using docker-compose)
# DB_URL=postgresql+asyncpg://api_user:pass123@db:5432/user_microservice_db

# ==================== CORS ====================
# Allow local frontend development
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ==================== JWT Authentication ====================
# Development keys - DO NOT use in production!
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here-minimum-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# ==================== Logging ====================
# Verbose for debugging
LOG_LEVEL=DEBUG
LOG_FILE=app.log
LOG_FORMAT=console

# ==================== Rate Limiting ====================
# Relaxed for development
RATE_LIMIT_BATCH=100/minute
RATE_LIMIT_WRITE=300/minute
RATE_LIMIT_READ=500/minute

# ==================== Redis Cache ====================
# Local instance
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL=300
CACHE_ENABLED=true

# ==================== Monitoring ====================
# Prometheus metrics
ENABLE_METRICS=true
