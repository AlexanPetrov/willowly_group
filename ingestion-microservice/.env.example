# Ingestion Microservice Environment Configuration
# Copy this to .env and fill in your actual values
# Never commit .env to git!

# ==================== Environment ====================
APP_ENV=dev
APP_NAME=Ingestion Microservice

# ==================== JWT Authentication ====================
# Must match User/RAG services for token validation
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-minimum-32-characters-long
JWT_ALGORITHM=HS256

# ==================== Redis & Celery ====================
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ==================== API Settings ====================
API_HOST=0.0.0.0
API_PORT=8003

# ==================== Ollama LLM ====================
OLLAMA_HOST=http://127.0.0.1:11434
EMB_MODEL=nomic-embed-text

# ==================== ChromaDB ====================
CHROMA_PATH=../data/chroma_db
CHROMA_COLLECTION_NAME=rag_docs
CHROMA_DISTANCE=cosine

# ==================== Data Paths ====================
RAW_DATA_DIR=../data/raw
UPLOAD_DIR=../data/uploads

# ==================== Chunking Settings ====================
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=140
CHARS_PER_TOKEN=4.0

# ==================== Ingestion Pipeline ====================
HASH_ALGO=xxh3
INGEST_BATCH_SIZE=128
MAX_WORKERS=4
EMBEDDING_TIMEOUT=30
EMBEDDING_RETRIES=3

# ==================== Memory Optimization ====================
ADAPTIVE_BATCH_SIZE=true
STREAM_CHUNK_SIZE=65536
MEMORY_BUFFER_MB=100

# ==================== File Upload ====================
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,txt

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FILE=ingestion.log
LOG_FORMAT=console
