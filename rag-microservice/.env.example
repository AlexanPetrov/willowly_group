# RAG Microservice Environment Configuration
# Copy this to .env.dev or .env for local development
# Never commit .env files with real secrets to git!

# ==================== Environment ====================
APP_ENV=dev
LOG_LEVEL=DEBUG

# ==================== Security ====================
# Development keys - DO NOT use in production!
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters-long
JWT_SECRET_KEY=your-jwt-secret-key-here-minimum-32-characters-long
JWT_ALGORITHM=HS256

# ==================== CORS ====================
# Permissive for local development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001

# ==================== ChromaDB ====================
# Local development data (shared with ingestion service)
CHROMA_PATH=../data/chroma_db
CHROMA_COLLECTION_NAME=rag_docs
CHROMA_DISTANCE=cosine

# ==================== Retrieval Settings ====================
RETRIEVAL_K=3
MIN_SIMILARITY=0.65

# ==================== LLM Settings (Ollama) ====================
OLLAMA_HOST=http://127.0.0.1:11434
GEN_MODEL=llama3.1:8b
NUM_CTX=4096
NUM_PREDICT=512
TEMPERATURE=0.25

# ==================== Monitoring ====================
ENABLE_METRICS=true
